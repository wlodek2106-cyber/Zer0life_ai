TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
BOT_TOKEN=123456789:replace-with-your-telegram-bot-token
PRIVATE_KEY=replace-with-server-side-base58-treasury-key
ZRL_MINT=replace-with-zrl-token-mint
MAX_DAILY_ZRL_WITHDRAWAL=10000
OPENAI_API_KEY=sk-proj-xxxxxx
ADMIN_TELEGRAM_ID=123456789
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETSY_URL=https://www.etsy.com
ALLEGRO_URL=https://allegro.pl
AMAZON_URL=https://www.amazon.com
OPENAI_MODEL=gpt-4o-mini
USAGE_DB_PATH=usage.sqlite3

# Private off-disk backups: disabled until a private external bucket, scoped
# credentials and a separately escrowed encryption key are configured in Render.
# See docs/private-backups.md. Never commit a real .env or database.
BACKUP_ENABLED=false
BACKUP_S3_PREFIX=zerolife-ledger
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_COUNT=48
BACKUP_KEEP_DAYS=30
BACKUP_HISTORICAL_JSON_PATHS=[]
